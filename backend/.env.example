# CloudGuard Backend Environment Configuration Example
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,https://your-frontend.vercel.app

# Supabase
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Security
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Web Application URL
FRONTEND_URL=https://your-frontend.vercel.app

# Transactional Email (Gmail SMTP or Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=CloudGuard Security
SMTP_USE_TLS=true
SMTP_USE_SSL=false
