# ==============================================================================
# CloudGuard Environment Configuration
# Copy this file to .env.local (for frontend) and backend/.env (for backend API)
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite / Client Safe)
# ------------------------------------------------------------------------------
# Base URL of the CloudGuard FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# Supabase public credentials (safe for browser)
VITE_SUPABASE_URL=https://ewmzfmshderlylfysdma.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Ddl1D5zEX3APTgu2PWJdWA_ahz-4Fyv

# Google OAuth client ID (public value)
# Client secret must NEVER live in frontend code; the backend performs code exchange.
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# BACKEND FASTAPI CONFIGURATION (Private / Server-Only Secrets)
# Never expose these in client code or commit actual values to git!
# ------------------------------------------------------------------------------
# Server host & port
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Project Credentials
SUPABASE_URL=https://ewmzfmshderlylfysdma.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ddl1D5zEX3APTgu2PWJdWA_ahz-4Fyv

# Supabase Service Role Secret Key (Required for backend admin operations, bypassing RLS)
# Find in Supabase Dashboard -> Project Settings -> API -> Project API Keys (service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# Direct PostgreSQL connection string (for migrations / direct pool access)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_db_password@db.ewmzfmshderlylfysdma.supabase.co:5432/postgres

# Application JWT signing secret for FastAPI sessions
JWT_SECRET=generate_a_random_32_character_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Web Application URL (for invitation links and notification redirects)
FRONTEND_URL=http://localhost:5173

# Transactional Email Gateway (SMTP / Gmail / Resend)
# Required for Option 2 (delivering real invitation and dual alert emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="CloudGuard Security"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional Alternative: Resend API Key (https://resend.com)
RESEND_API_KEY=
