# CloudGuard frontend environment configuration.
# Copy to .env.local and adjust for your environment.

# Base URL of the CloudGuard FastAPI backend (no trailing slash).
VITE_API_URL=http://localhost:8000

# Google OAuth client ID (public value, safe for the frontend).
# The client secret must never live in frontend code; the backend performs
# the code exchange.
VITE_GOOGLE_CLIENT_ID=
